REVISION=2
BOARD:=tf536
FULL?=1
CLOCK_PHASE?=7

all: $(BOARDPREFIX)
include ../Makefile.inc

$(BOARDPREFIX): a500 cdtv

a500:
	$(XILINXENV) make -f ../Makefile.cpld BOARD=$(BOARD) SOURCES=$(SOURCES) SUBPROJ=main REVISION=$(REVISION) OPTMODE=speed OPTIMISE=speed CLOCK_PHASE=$(CLOCK_PHASE) FULL=$(FULL) TARGET=A500
cdtv:
	$(XILINXENV) make -f ../Makefile.cpld BOARD=$(BOARD) SOURCES=$(SOURCES) SUBPROJ=main REVISION=$(REVISION) OPTMODE=speed OPTIMISE=speed CLOCK_PHASE=$(CLOCK_PHASE) FULL=$(FULL) TARGET=CDTV
