REVISION=2
BOARD:=tf536
CLOCK_PHASE?=7

all: $(BOARDPREFIX)
include ../Makefile.inc

$(BOARDPREFIX): a500 cdtv

# Build both XC95144XL and XC95288XL variants for A500
a500: a500-144 a500-288

a500-144:
	$(XILINXENV) make -f ../Makefile.cpld BOARD=$(BOARD) SOURCES=$(SOURCES) SUBPROJ=main REVISION=$(REVISION) OPTMODE=speed OPTIMISE=speed CLOCK_PHASE=$(CLOCK_PHASE) FULL=0 TARGET=A500

a500-288:
	$(XILINXENV) make -f ../Makefile.cpld BOARD=$(BOARD) SOURCES=$(SOURCES) SUBPROJ=main REVISION=$(REVISION) OPTMODE=speed OPTIMISE=speed CLOCK_PHASE=$(CLOCK_PHASE) FULL=1 TARGET=A500

# Build both XC95144XL and XC95288XL variants for CDTV
cdtv: cdtv-144 cdtv-288

cdtv-144:
	$(XILINXENV) make -f ../Makefile.cpld BOARD=$(BOARD) SOURCES=$(SOURCES) SUBPROJ=main REVISION=$(REVISION) OPTMODE=speed OPTIMISE=speed CLOCK_PHASE=$(CLOCK_PHASE) FULL=0 TARGET=CDTV

cdtv-288:
	$(XILINXENV) make -f ../Makefile.cpld BOARD=$(BOARD) SOURCES=$(SOURCES) SUBPROJ=main REVISION=$(REVISION) OPTMODE=speed OPTIMISE=speed CLOCK_PHASE=$(CLOCK_PHASE) FULL=1 TARGET=CDTV
